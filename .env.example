# Upstash Redis from the Upstash console (Singapore or Tokyo).
# Paste these into Vercel → Environment Variables. No Blob store.

# Primary
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Marketplace / KV aliases
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional owner recovery key (min 12 chars). Enter it on any PIN screen
# (tap Key) to open Admin for any event and view or reset the helper PIN.
ADMIN_MASTER_KEY=
